{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Court Booker",
  "identifier": "com.servedbyhau.courtbooker",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Court Booker",
        "width": 1280,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/court-booker": "court-booker"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMjY3NTVDQzIzNkI5MjYKUldRbXVUYkNYSFVtY25WdjdRN0RDUHRWTkFhTU9xTjBLL1hGcHZ0c2Z2cUlQdWEvSzBhRmxrTWIK",
      "endpoints": [
        "https://github.com/servedbyhau/vh-tennis-booker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
