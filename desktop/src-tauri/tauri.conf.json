{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Court Booker",
  "identifier": "com.servedbyhau.courtbooker",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Court Booker",
        "width": 1280,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../dist/court-booker": "court-booker"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
